# Valgrind suppressions for the *shipped* liboqs-0.14.0 optimized build.
#
# Each entry below corresponds 1:1 to an officially-audited false positive in
# liboqs' own constant-time test suppression files
# (vendor/liboqs-src/tests/constant_time/kem/passes/{bike,ml_kem}).
# The only difference is the frame names: the shipped Release build inlines the
# small helpers (rotate256_small, _mm256_*, mlk_check_sk, rej_uniform), so the
# top frame reported by memcheck is the *enclosing* exported function. The
# underlying secret-data flow is identical to the audited cases.

# --- BIKE-L1 -----------------------------------------------------------------
# Official: "Rotate the syndrome vector part 1/2" -> _mm256_slli/srli_epi64
#           inside OQS_KEM_bike_*_rotate256_small.
# Shipped : rotate256_small + the intrinsics are inlined into rotate_right_avx2.
# Cause   : constant-time barrel rotation; the secret rotation amount is fed to
#           a data-independent SIMD shift (vpsllq/vpsrlq) as DATA, not as a
#           branch condition or memory index. Benign.
{
   BIKE constant-time syndrome rotation (inlined rotate256_small)
   Memcheck:Value1
   fun:OQS_KEM_bike_l1_rotate_right_avx2
}
{
   BIKE constant-time syndrome rotation cond (inlined)
   Memcheck:Cond
   fun:OQS_KEM_bike_l1_rotate_right_avx2
}

# Frame-robust variants: when the compiler inlines the _mm256_* intrinsic, the
# resolved top frame becomes rotate256_small itself (decode_avx2.c). Same
# audited benign barrel-rotation. (covers GCC/Clang -O1/-Os/-O3 inlining)
{
   BIKE constant-time rotate256_small (intrinsic inlined)
   Memcheck:Value1
   fun:OQS_KEM_bike_l1_rotate256_small
}
{
   BIKE constant-time rotate256_small Value8
   Memcheck:Value8
   fun:OQS_KEM_bike_l1_rotate256_small
}

# Official: "Setting bits in a secret error vector" -> secure_set_bits_avx2.
# Cause   : constant-time scatter of secret bit positions via masked SIMD; the
#           secret index drives a data-independent shift, not an address. Benign.
{
   BIKE constant-time secure_set_bits
   Memcheck:Value1
   fun:OQS_KEM_bike_l1_secure_set_bits_avx2
}
{
   BIKE constant-time secure_set_bits cond
   Memcheck:Cond
   fun:OQS_KEM_bike_l1_secure_set_bits_avx2
}

# --- ML-KEM-768 --------------------------------------------------------------
# Official: "Rejection sampling to produce public A matrix" -> gen_matrix ->
#           indcpa_enc (the FO re-encryption). The seed rho is PUBLIC (it is
#           part of the public key embedded in sk), so branching on rho-derived
#           sample values is not a secret-dependent branch. Benign.
{
   ML-KEM rejection sampling on public A matrix (rej_uniform_avx2)
   Memcheck:Value8
   fun:PQCP_MLKEM_NATIVE_MLKEM768_X86_64_rej_uniform_avx2
}
{
   ML-KEM rejection sampling on public A matrix (poly_rej_uniform_x4)
   Memcheck:Value8
   fun:PQCP_MLKEM_NATIVE_MLKEM768_X86_64_poly_rej_uniform_x4
}
{
   ML-KEM rejection sampling on public A matrix (poly_rej_uniform)
   Memcheck:Value8
   fun:PQCP_MLKEM_NATIVE_MLKEM768_X86_64_poly_rej_uniform
}
{
   ML-KEM rejection sampling on public A matrix (cond, rej_uniform_avx2)
   Memcheck:Cond
   fun:PQCP_MLKEM_NATIVE_MLKEM768_X86_64_rej_uniform_avx2
}

# Official: "The parts of sk being hashed and compared here are public" ->
#           mlk_check_sk, inlined into ..._dec in the shipped build. Benign.
{
   ML-KEM public sk-hash check (inlined mlk_check_sk)
   Memcheck:Cond
   fun:PQCP_MLKEM_NATIVE_MLKEM768_X86_64_dec
}

# Official anchored form: any Cond/Value8 reached through gen_matrix -> indcpa
# is rejection sampling on the public A matrix (covers the poly_rej_uniform
# wrappers regardless of which rej helper is the top frame). Mirrors the
# official ml_kem/kyber "..." + gen_matrix + indcpa_* suppressions.
{
   ML-KEM rejection sampling on public A matrix (anchored Cond)
   Memcheck:Cond
   ...
   fun:PQCP_MLKEM_NATIVE_MLKEM768_X86_64_gen_matrix
   fun:PQCP_MLKEM_NATIVE_MLKEM768_X86_64_indcpa_*
}
{
   ML-KEM rejection sampling on public A matrix (anchored Value8)
   Memcheck:Value8
   ...
   fun:PQCP_MLKEM_NATIVE_MLKEM768_X86_64_gen_matrix
   fun:PQCP_MLKEM_NATIVE_MLKEM768_X86_64_indcpa_*
}
